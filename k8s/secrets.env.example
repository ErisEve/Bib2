# Copy to secrets.env and fill in. secrets.env is gitignored.
#
# JWT_SECRET must be at least 32 characters (HS256 needs a 256-bit key). Every
# service reads it from this one Secret, which is the point: if the values ever
# diverged, tokens issued by user-service would silently fail to validate
# everywhere else.
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-value-of-32-chars-or-more
