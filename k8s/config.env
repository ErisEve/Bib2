# Non-secret configuration, shared by every service. Mirrors the environment
# blocks in docker-compose.yml - only the hostnames change, because Kubernetes
# Services resolve by name just like Compose's network aliases did.

# Discovery. Services register their pod IP (eureka.instance.prefer-ip-address),
# so lb:// routing in the gateway resolves straight to pods.
EUREKA_URL=http://eureka-server:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=eureka-server

# Feign clients hairpin service-to-service calls back through the gateway.
GATEWAY_URL=http://gateway-service:8080

# One shared database for all four data services.
DB_URL=jdbc:postgresql://postgres:5432/library_metadata
DB_USERNAME=postgres
POSTGRES_USER=postgres
POSTGRES_DB=library_metadata

JWT_EXPIRATION_MS=36000000

# Comma-separated origin patterns, read by the gateway and all four services.
# "*" accepts any origin, so the app works from any node IP or domain name.
# To lock it down, list the origins (scheme, host and port, exactly as typed in
# the address bar), e.g. http://10.100.50.*:8080 - a browser origin that does not
# match gets "Invalid CORS request" and logins fail with a 403.
CORS_ALLOWED_ORIGINS=*
